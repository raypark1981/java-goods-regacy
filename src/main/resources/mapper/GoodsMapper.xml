<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    namespace = Mapper 인터페이스 전체 경로와 반드시 일치해야 한다.
    MyBatis가 이 XML과 GoodsMapper.java 인터페이스를 연결하는 기준이다.
-->
<mapper namespace="com.hyundaicard.mmall.dao.GoodsMapper">

    <!-- 공통 컬럼 목록 (중복 제거용) -->
    <sql id="goodsColumns">
        GD_CD, GD_NM, GD_PRICE, GD_DESC, GD_IMG_URL, USE_YN
    </sql>

    <!-- 상품 상세 조회 -->
    <!-- id = GoodsMapper 인터페이스의 메서드명과 일치 -->
    <select id="selectGoodsDetail" parameterType="String" resultType="com.hyundaicard.mmall.model.GoodsVO">
        SELECT
            <include refid="goodsColumns"/>
        FROM
            TB_GOODS
        WHERE
            GD_CD = #{gdCd}
            AND USE_YN = 'Y'
    </select>

    <!-- 상품 목록 조회 -->
    <select id="selectGoodsList" resultType="com.hyundaicard.mmall.model.GoodsVO">
        SELECT
            <include refid="goodsColumns"/>
        FROM
            TB_GOODS
        WHERE
            USE_YN = 'Y'
        ORDER BY
            GD_CD DESC
    </select>

</mapper>
