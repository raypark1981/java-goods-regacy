<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hmfrnt.cu.cud.mapper.CUDCmctDAO">

    <!-- 공지사항 목록 조회 (Mock: 실제 SQL은 운영 소스 반영 시 작성) -->
    <select id="selectAncmDtlList" parameterType="hmfrnt.common.HdgmMap"
            resultType="hmfrnt.common.HdgmMap">
        SELECT 'MOCK_ID'   AS BBC_ID
             , 'Mock 공지 제목' AS BBC_TITL
          FROM DUAL
    </select>

    <!-- 공지사항 상세 조회 -->
    <select id="selectAncmDtlView" parameterType="hmfrnt.common.HdgmMap"
            resultType="hmfrnt.cu.cud.vo.AncmVO">
        SELECT 'MOCK_ID'       AS BBC_ID
             , 'Mock 공지 제목'   AS BBC_TITL
             , 'Mock 공지 내용입니다.' AS BBC_CNTN
             , #{globLang}     AS GLOB_LANG
          FROM DUAL
         WHERE 1 = 1
    </select>

</mapper>
